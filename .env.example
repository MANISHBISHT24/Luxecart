# ==============================================================================
# LuxeCart Environment Variables (.env.example)
# Duplicate this file as .env and fill in real or sandbox credentials.
# ==============================================================================

# Database Connection (PostgreSQL with Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/luxecart?schema=public"

# Application Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentication & Session Security (OWASP 256-bit entropy)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your_high_entropy_session_secret_min_32_chars_long_placeholder"
JWT_SECRET="your_high_entropy_jwt_secret_min_32_chars_long_placeholder"

# Payment Gateway: Razorpay (Test Mode credentials by default)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdPlaceholder"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyPlaceholder"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretPlaceholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdPlaceholder"

# Optional Stripe Integration (Alternative provider)
STRIPE_SECRET_KEY="sk_test_YourStripeSecretKeyPlaceholder"
STRIPE_WEBHOOK_SECRET="whsec_YourStripeWebhookSecretPlaceholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YourStripePublicKeyPlaceholder"

# Security & Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
